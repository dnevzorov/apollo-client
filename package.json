{
  "name": "@dnevzorov/apollo-client",
  "version": "1.1.3",
  "description": "Apollo Client drop-in replacement with automatic cache updates",
  "keywords": [
    "apollo",
    "apollo-react",
    "apollo-react-hooks",
    "react",
    "react-hooks"
  ],
  "license": "MIT",
  "author": "Dmitriy Nevzorov",
  "repository": {
    "type": "git",
    "url": "https://github.com/dnevzorov/apollo-client.git"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rm -rf dist && rollup -c",
    "commitlint": "commitlint --edit",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "prepack": "pnpm build",
    "prepare": "husky",
    "release": "release-it",
    "start": "rollup -c -w",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit --incremental"
  },
  "dependencies": {
    "immer": "^11.0.0"
  },
  "devDependencies": {
    "@apollo/client": "^4.3.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@release-it/conventional-changelog": "^12.0.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "graphql": "^16.14.2",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2006",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "release-it": "^21.1.1",
    "rollup": "^4.66.0",
    "rollup-plugin-esbuild": "^6.2.1",
    "rxjs": "^7.8.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@apollo/client": "^3.7.0 || ^4.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,yml,json,md}": "oxfmt --no-error-on-unmatched-pattern",
    "{src,test}/**/*.{ts,tsx}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "sh -c 'tsc --noEmit'",
      "oxlint --no-error-on-unmatched-pattern --type-aware --fix --quiet"
    ]
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
